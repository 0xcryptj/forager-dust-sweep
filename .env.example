# ForagerDustSweepRouter — copy to .env (never commit .env)

# Deployer key (hex, with or without 0x). Never echo this.
PRIVATE_KEY=

# Optional: override owner (defaults to the deployer address)
# OWNER=

# Canonical Uniswap Permit2 (same on Base mainnet and Base Sepolia)
PERMIT2=0x000000000022D473030F116dDEE9F6B43aC78BA3

# Canonical WETH on OP-stack Base (mainnet + Sepolia)
WETH=0x4200000000000000000000000000000000000006

# Joseph's EVM fee collector (FORAGER_EVM_FEE_WALLET)
FEE_COLLECTOR=0x2db772BB8F0e01Ea259011C600eD6F685A29aD51

# 200 = 2%. Contract hard-caps at 300 (3%).
FEE_BPS=200

# Set after Deploy.s.sol broadcasts
ROUTER=

# RPCs
BASE_RPC_URL=https://mainnet.base.org
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org

# Optional — BaseScan / Etherscan V2 key for --verify
BASESCAN_API_KEY=
